# In the Claude cloud environment: add each as an environment variable (preferred).
# On a local machine: copy to .env and fill in. NEVER commit .env or paste these values in chat or docs.
# At handover these move to Lorena's Claude cloud environment as secrets, and she regenerates every key.

# --- Google (service account in the Google Cloud project owned by the business account) ---
# Claude cloud environment: base64 of the whole key file, on ONE line (docs/setup/google-cloud.md)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# ...or the key file's full text...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or, on a local machine, the path to the key file (outside the repo)
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: the sheet is found by name among the files shared with the service account
LULA_WORKBOOK_NAME=LulaMacaroni Operaciones
# Optional: pin the sheet by its ID (the long string in its URL)
LULA_WORKBOOK_ID=
# Optional: force "google" or "local" (default: google when a key is configured)
LULA_LIBRO=
# ID of the Drive folder that holds masters, print files, mockups and research exports
LULA_DRIVE_FOLDER_ID=

# --- Prodigi (POD provider) ---
# "sandbox" while building; switch to "live" only after Lorena approves the first real order
PRODIGI_ENV=sandbox
# Each environment has its own key (Prodigi dashboard > Settings > Integrations > API)
PRODIGI_SANDBOX_API_KEY=
PRODIGI_API_KEY=

# --- Shopify ("LulaMacaroni Operaciones" Dev Dashboard app, client-credentials grant) ---
# The *.myshopify.com address, not the public domain
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-10

# --- Etsy (Open API v3 developer app registered under Lorena's Etsy login) ---
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_REFRESH_TOKEN=

# --- QuickBooks Online (US LLC books; OAuth app) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
QBO_ENV=sandbox

# --- Meta (Instagram + ads; later phases, needs app review) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
INSTAGRAM_BUSINESS_ID=

# --- Pinterest (API v5, read-only; docs/setup/pinterest.md) ---
PINTEREST_ACCESS_TOKEN=
# expiry date of the token above (YYYY-MM-DD); Alertas warns 7 days before
PINTEREST_TOKEN_VENCE=

# --- Claude API (agents that run on a schedule) ---
ANTHROPIC_API_KEY=

# --- Approval page ---
# Approvals file used only when no Google key is configured (otherwise the Aprobaciones tab)
LULA_APPROVALS_PATH=data/aprobaciones.json
# Port for `python -m lulamacaroni.approval.server`
LULA_APPROVAL_PORT=8765

# --- Back office app ---
# Where connectors write and the app reads when no Google key is configured (git-ignored)
LULA_LOCAL_DATA=data/libro
# Port for `python -m lulamacaroni.app.server`
LULA_APP_PORT=8770
# "Hoy" and every period are counted in this time zone
LULA_TZ=America/Mexico_City
